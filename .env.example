# 複製成 .env 後修改。.env 不進 git，權限設 600（chmod 600 .env）。
# 下面是本機開發的值；主機上的值見 README「部署到 Lightsail」。

# --- 主機才需要 ---
# 主機上取消註解：疊上 docker-compose.prod.yml（加 cloudflared、caddy 不開 port）
#COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
# 【待填】Cloudflare Zero Trust → 網路 → Tunnels → sitelog → 安裝連接器畫面裡的 token（eyJ 開頭那一長串）
#TUNNEL_TOKEN=

# --- 網域（一律帶 http://，HTTPS 由 Cloudflare 負責）---
# 【待填】主機上改成正式網域，例：http://drive.example.com、http://sitelog.example.com
DRIVE_DOMAIN=http://drive.localhost
FORM_DOMAIN=http://form.localhost
# /admin 頁首的「網盤」連結（使用者看到的網址，主機上是 https://）；表單頁不放網盤連結
DRIVE_URL=http://drive.localhost

# --- form-app → Cloudreve WebDAV（經 compose 內網，不走外網）---
# 不要改成外部網址：form-app 要經 compose 內網直連 Cloudreve（外部 /dav 被 Caddy 擋掉）
WEBDAV_URL=http://cloudreve:5212/dav
# 【待填】Cloudreve 裡 form-app 專用使用者的 email
WEBDAV_USER=form-app@example.com
# 【待填】Cloudreve「WebDAV 帳號」產生的密碼（不是登入密碼）
WEBDAV_PASSWORD=change-me
# 相對於 WebDAV 帳號根目錄的上傳位置。帳號根目錄已在 Cloudreve 限定為網盤的 /form-output，
# 所以這裡填 /，檔案會進到網盤的 /form-output/YYYY/MM/。
# （若填 /form-output 會變成網盤的 /form-output/form-output/）
UPLOAD_ROOT=/

# --- 防濫用 ---
RATE_LIMIT=5/minute

TZ=Asia/Taipei
# 選填的第二層「上傳代碼」；留空不檢查
UPLOAD_PIN=

# --- Cloudflare Turnstile（防機器人）---
# 本機用 Cloudflare 官方測試金鑰（一定通過）；上線改成 Cloudflare 後台 Turnstile 產生的金鑰
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
# 上線填表單網域（例：form.example.com），會檢查 token 是不是在這個網域產生的；本機留空
TURNSTILE_HOSTNAME=

# --- Cloudflare Access（白名單登入）---
# 兩個都填才會驗證 Cf-Access-Jwt-Assertion；本機留空 = 不驗證
# 【待填】Zero Trust → 設定 → 團隊網域，例：xxx.cloudflareaccess.com
ACCESS_TEAM_DOMAIN=
# 【待填】Access → 應用程式 → 表單 → AUD 標籤
ACCESS_AUD=

# --- 白名單管理頁 /admin（選填；全部填好才會啟用，而且要先啟用 Cloudflare Access）---
# 可以進管理頁的 email，逗號分隔。這些 email 要直接寫在 Access 原則裡（不要放進清單，免得把自己刪掉）
ADMIN_EMAILS=
# 【待填】Cloudflare 帳戶 ID
CF_ACCOUNT_ID=
# 【待填】Zero Trust → 我的團隊 → 清單 → 表單白名單的 ID（Access 原則的 Include 用「電子郵件清單」引用它）
CF_LIST_ID=
# 【待填】Cloudflare API 權杖：只給「帳戶 → Zero Trust → 編輯」，不設到期日（移除白名單時也用它撤銷登入）
CF_API_TOKEN=

# --- 網盤白名單（選填；要先在 Cloudflare Access 把網盤也保護起來，見 README「網盤白名單」）---
# 【待填】Zero Trust → 我的團隊 → 清單 → 網盤白名單的 ID
CF_DRIVE_LIST_ID=
# 【待填】form-output 的分享連結（給網盤白名單的人看檔案，/admin 會附上），例：https://drive.example.com/s/xxxx
DRIVE_SHARE_URL=

# --- Word 轉 PDF（選填）---
# 不寫這行 = 用 compose 裡的 gotenberg；寫成空白 GOTENBERG_URL= 就不轉 PDF，手機照舊下載 Word
# GOTENBERG_URL=http://gotenberg:3000
